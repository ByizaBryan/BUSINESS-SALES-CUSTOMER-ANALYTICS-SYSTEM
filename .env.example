# ==============================================================================
# InsightMart Business Sales & Customer Analytics System
# Environment Configuration Template
# ==============================================================================

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=business_sales_db
DB_USER=root
DB_PASSWORD=

# Database Engine Override: 'mysql' (default) or 'sqlite' (local fallback)
DB_TYPE=mysql
SQLITE_PATH=data/processed/business_sales.db

# Flask Application Settings
FLASK_APP=app.app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=insightmart_super_secure_secret_key_change_in_production_2026

# Server Port
PORT=5000
